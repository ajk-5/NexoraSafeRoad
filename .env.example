# Copy to .env at the repository root. Never commit the real .env file.
# Generate separate values using: python -c "import secrets; print(secrets.token_hex(32))"
AI_API_KEY=
POSTGRES_USER=saferoad
POSTGRES_DB=saferoad
POSTGRES_PASSWORD=

# Optional for direct Python runs; Docker Compose constructs its own database URL.
# DATABASE_URL=sqlite:///backend/saferoad.db
CORS_ORIGINS=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Enable only for local demo accounts. Use a unique password of 15–128 characters.
SEED_DEMO_OPERATORS=0
DEMO_PASSWORD=
